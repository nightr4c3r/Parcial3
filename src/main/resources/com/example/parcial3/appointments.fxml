<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.parcial3.Controllers.AppointmentsController">
    <top>
        <Label text="Schedule Appointment" style="-fx-font-size: 20px; -fx-font-weight: bold;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </Label>
    </top>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="140"/>
                    <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Patient:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbPatient" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="Doctor:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbDoctor" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="Date:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="datePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Time (HH:mm):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTime" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="HH:mm"/>
            </GridPane>

            <TableView fx:id="tableAppointments" prefHeight="260">
                <columns>
                    <TableColumn fx:id="colAPatient" text="Patient" prefWidth="220"/>
                    <TableColumn fx:id="colADoctor" text="Doctor" prefWidth="220"/>
                    <TableColumn fx:id="colADateTime" text="Date &amp; Time" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Back" onAction="#onBack"/>
            <Button text="Delete" onAction="#onDelete"/>
            <Button text="Save" onAction="#onSave"/>
        </HBox>
    </bottom>
</BorderPane>
